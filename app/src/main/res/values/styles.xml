<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========== BUTTON STYLES ========== -->
    <style name="Widget.TravelCompanion.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.TravelCompanion.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- ========== TEXT APPEARANCES ========== -->
    <style name="TextAppearance.TravelCompanion.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.TravelCompanion.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.TravelCompanion.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.TravelCompanion.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.TravelCompanion.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.TravelCompanion.TitleSmall" parent="TextAppearance.Material3.TitleSmall" />
    <style name="TextAppearance.TravelCompanion.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>
    <style name="TextAppearance.TravelCompanion.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>
    <style name="TextAppearance.TravelCompanion.BodySmall" parent="TextAppearance.Material3.BodySmall" />
    <style name="TextAppearance.TravelCompanion.LabelLarge" parent="TextAppearance.Material3.LabelLarge" />
    <style name="TextAppearance.TravelCompanion.LabelMedium" parent="TextAppearance.Material3.LabelMedium" />
    <style name="TextAppearance.TravelCompanion.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.TravelCompanion.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.TravelCompanion.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/navBarInactive</item>
    </style>

    <!-- ========== CARD STYLES ========== -->
    <style name="Widget.TravelCompanion.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.TravelCompanion.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.TravelCompanion.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.TravelCompanion.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- ========== OTHER WIDGETS ========== -->
    <style name="Widget.TravelCompanion.BottomNavigation" parent="Widget.Material3.BottomNavigationView" />

    <style name="Widget.TravelCompanion.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/chipBackground</item>
        <item name="android:width">64dp</item>
        <item name="android:height">36dp</item>
        <item name="marginHorizontal">8dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <style name="Widget.TravelCompanion.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
    </style>
    <style name="Widget.TravelCompanion.Button.Tonal" parent="Widget.Material3.Button.TonalButton" />
    <style name="Widget.TravelCompanion.Button.Text" parent="Widget.Material3.Button.TextButton" />
    <style name="Widget.TravelCompanion.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton" />
    <style name="Widget.TravelCompanion.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox.Dense" />
    <style name="Widget.TravelCompanion.Switch" parent="Widget.Material3.CompoundButton.Switch" />

    <style name="Widget.TravelCompanion.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/chipBackground</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">@color/chipText</item>
        <item name="chipIconTint">@color/chipIcon</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Small</item>
    </style>
</resources>
