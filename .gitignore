# Gradle and build outputs
.gradle/
build/
app/build/

# Android Studio / JetBrains artifacts
.idea/
*.iml
.vscode/

# Local configuration
local.properties

# Android/NDK generated folders and logs
captures/
.externalNativeBuild/
.cxx/
*.hprof

# Misc
.DS_Store
Thumbs.db
*.tmp
*.bak
*.swp
output.json
__TO_DELETE__/
*.apk
*.ap_

# Ignore accidental Gradle distributions and JVM crash/logs
gradle-*/
hs_err_pid*.log

# Ignore log files
*.log

# Backup and temporary outputs created by cleanup scripts or this automation
backup_*/
cleanup_backup_*/
removed_assets_backup/
removed_code_backup/

# Project-level logs and temporary outputs
assemble_output.txt
build_output.txt
crash_output.txt
full_log.txt
kotlin_build*.txt

# Analysis / report files (generated by tools)
all_res.txt
unused_res.txt
refs.txt
kotlin_symbol_refs.txt
kotlin_unused_candidates.txt
kotlin_symbol_refs*.csv
kotlin_unused_candidates*.csv
final_non_source_backup.zip

# Kotlin caches
.kotlin/

# Tools outputs
# (keep scripts in tools/ but ignore generated outputs)
tools/*.py

# Archive folders created by cleanup
archive_*/

# Ensure gradle wrapper files are NOT ignored (keep wrapper in repo)
!/gradle/wrapper/gradle-wrapper.properties
!/gradle/wrapper/gradle-wrapper.jar

# End of .gitignore
