<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- RIMOSSO: Definizione duplicata di Widget.TravelCompanion.Button -->
    <style name="Widget.TravelCompanion.Button.Dark" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/md_theme_dark_primary</item>
        <item name="android:textColor">@color/md_theme_dark_onPrimary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Modern Material3 Button Style -->
    <style name="Widget.TravelCompanion.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/secondary</item>
        <item name="android:textColor">@color/onSecondary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.TravelCompanion.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/onPrimary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- TextAppearance custom -->
    <style name="TextAppearance.TravelCompanion.BodySmall" parent="TextAppearance.Material3.BodySmall" />
    <style name="TextAppearance.TravelCompanion.BodyMedium" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.TravelCompanion.BodyLarge" parent="TextAppearance.Material3.BodyLarge" />
    <style name="TextAppearance.TravelCompanion.Body2" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.TravelCompanion.TitleSmall" parent="TextAppearance.Material3.TitleSmall" />
    <style name="TextAppearance.TravelCompanion.TitleMedium" parent="TextAppearance.Material3.TitleMedium" />
    <style name="TextAppearance.TravelCompanion.TitleLarge" parent="TextAppearance.Material3.TitleLarge" />
    <style name="TextAppearance.TravelCompanion.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall" />
    <style name="TextAppearance.TravelCompanion.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium" />
    <style name="TextAppearance.TravelCompanion.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge" />
    <style name="TextAppearance.TravelCompanion.Headline5" parent="TextAppearance.Material3.HeadlineMedium" />
    <style name="TextAppearance.TravelCompanion.Headline6" parent="TextAppearance.Material3.HeadlineSmall" />
    <style name="TextAppearance.TravelCompanion.Subtitle1" parent="TextAppearance.Material3.TitleMedium" />
    <style name="TextAppearance.TravelCompanion.Body1" parent="TextAppearance.Material3.BodyLarge" />
    <style name="TextAppearance.TravelCompanion.Caption" parent="TextAppearance.Material3.LabelSmall" />
    <style name="TextAppearance.TravelCompanion.LabelMedium" parent="TextAppearance.Material3.LabelMedium" />
    <style name="TextAppearance.TravelCompanion.LabelLarge" parent="TextAppearance.Material3.LabelLarge" />
    <style name="TextAppearance.TravelCompanion.LabelSmall" parent="TextAppearance.Material3.LabelSmall" />
    <style name="TextAppearance.TravelCompanion.BottomNav.Active" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/onPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.TravelCompanion.BottomNav.Inactive" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/navBarInactive</item>
    </style>
    <style name="TextAppearance.TravelCompanion.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/onBackground</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.TravelCompanion.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Widget custom -->
    <style name="Widget.TravelCompanion.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.TravelCompanion.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="Widget.TravelCompanion.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#3B82F6</item>
    </style>

    <style name="Widget.TravelCompanion.Button.Tonal" parent="Widget.Material3.Button" />
    <style name="Widget.TravelCompanion.Button.Text" parent="Widget.Material3.Button.TextButton" />
    <style name="Widget.TravelCompanion.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox.Dense" />
    <style name="Widget.TravelCompanion.Card.Filled" parent="Widget.MaterialComponents.CardView" />
    <style name="Widget.TravelCompanion.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton" />
    <style name="Widget.TravelCompanion.Switch" parent="Widget.Material3.CompoundButton.Switch" />
    <style name="Widget.TravelCompanion.Card.Outlined" parent="Widget.MaterialComponents.CardView" />
    <style name="Widget.TravelCompanion.Card.Elevated" parent="Widget.MaterialComponents.CardView" />
    <style name="Widget.TravelCompanion.FAB" parent="Widget.MaterialComponents.ExtendedFloatingActionButton" />
    <style name="Widget.TravelCompanion.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/chipBackground</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chipText</item>
        <item name="chipIconTint">@color/chipIcon</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Small</item>
    </style>
    <style name="Widget.TravelCompanion.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
